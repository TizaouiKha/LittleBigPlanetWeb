{
  "name": "littlebigweb",
  "version": "0.1.0",
  "private": true,
  "description": "Un hommage a LittleBigPlanet jouable dans le navigateur",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "0.14.0",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
